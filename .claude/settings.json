{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(lake build *)",
      "Bash(lake exe generate-blog)"
    ],
    "ask": [
      "Edit(/PLAN.md)",
      "Edit(/lean-toolchain)",
      "Edit(/lakefile.toml)",
      "Edit(/lake-manifest.json)",
      "Bash(lake update *)"
    ],
    "deny": [
      "Edit(/private/**)",
      "Edit(/.lake/**)"
    ]
  }
}
